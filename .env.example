# Шаблон переменных окружения для Toy-Warehouse
# Скопируйте этот файл: cp .env.example WarehouseAPI/.env
# Затем заполните реальными значениями. НИКОГДА не коммитьте .env в git!

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
